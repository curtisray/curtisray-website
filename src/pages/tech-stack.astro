---
import DeveloperLayout from '../layouts/DeveloperLayout.astro';
import TechList from '../components/TechList.astro';
import { stacks } from '../data/site';
---

<DeveloperLayout
  title="Tech stack"
  intro="Each stack is selected for the project at hand. Balanced for quality and performance, built on clean, readable, templated code."
>
  {stacks.map((stack, i) => (
    <article class="content-row stack-row">
      <span class="row-number">{String(i + 1).padStart(2, '0')}</span>
      <div class="row-copy">
        <h2>{stack.title}</h2>
        <p>{stack.description}</p>
      </div>
      <TechList items={stack.technologies} />
    </article>
  ))}
  <p class="content-note turnstile-note">
    <span class="tech-icon">
      <img
        src="/logos/cloudflare.svg"
        alt=""
        width="16"
        height="16"
        loading="lazy"
      />
    </span>
    <span>
      Cloudflare Turnstile helps protect client inquiry forms from spam and
      automated submissions.
    </span>
  </p>
</DeveloperLayout>

<style>
  .turnstile-note {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .turnstile-note .tech-icon {
    width: 28px;
    height: 28px;
  }
  .turnstile-note img {
    width: 16px;
    height: 16px;
  }
</style>
