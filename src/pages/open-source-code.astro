---
import DeveloperLayout from '../layouts/DeveloperLayout.astro';
import TechList from '../components/TechList.astro';
import { repositories } from '../data/site';
---

<DeveloperLayout
  title="Open source code"
  intro="Selected projects with public source. Production builds, open for reference and reuse."
>
  {repositories.map((repo, i) => (
    <article class="content-row">
      <span class="row-number">{String(i + 1).padStart(2, '0')}</span>
      <div class="row-copy">
        <div class="project-heading">
          <h2>{repo.title}</h2>
          {repo.liveUrl && (
            <a
              class="source-link underline-link"
              href={repo.liveUrl}
              target={repo.liveUrl.startsWith('/') ? undefined : '_blank'}
              rel={
                repo.liveUrl.startsWith('/') ? undefined : 'noopener noreferrer'
              }
            >
              {repo.title.replace(/ website$/, '')} ↗
            </a>
          )}
        </div>
        <p>{repo.description}</p>
        <TechList items={repo.technologies} compact />
        <a
          class="source-link underline-link"
          href={`https://github.com/curtisray/${repo.repo}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          github.com/curtisray/{repo.repo}
        </a>
      </div>
    </article>
  ))}
  <p class="content-note">
    See{' '}
    <a class="source-link underline-link" href="/agent-skills">
      agent skills
    </a>{' '}
    for more on how these sites get built.
  </p>
</DeveloperLayout>

<style>
  .project-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-5);
  }
</style>
