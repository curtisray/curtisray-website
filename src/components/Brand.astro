---
import { Image } from 'astro:assets';
import penguin from '../assets/penguin-icon.png';
interface Props {
  href?: string;
  label?: string;
  class?: string;
  parallax?: boolean;
}
const {
  parallax = false,
  href = '/',
  label = 'Curtis Ray home',
  class: className,
} = Astro.props;
---

<a
  data-parallax={parallax ? 'text' : undefined}
  class:list={['brand', className]}
  href={href}
  aria-label={label}
>
  <Image src={penguin} alt="" width={88} height={72} />
  <span>Curtis</span>
</a>
