---
interface Props { id: string }
const { id } = Astro.props;
---
<div class="contact" data-contact>
  <button class="contact-trigger color-button" type="button" aria-expanded="false" aria-controls={id}>contact</button>
  <div class="contact-panel" id={id} role="dialog" aria-modal="false" aria-labelledby={`${id}-title`} hidden data-lenis-prevent>
    <form action="mailto:curtisraymaloney@gmail.com" method="get" data-contact-form>
      <div class="contact-heading">
        <span class="eyebrow" id={`${id}-title`}>Get in touch</span>
        <button class="contact-close" type="button" aria-label="Close contact form">×</button>
      </div>
      <label for={`${id}-name`}>Name<input id={`${id}-name`} name="name" type="text" autocomplete="name" required /></label>
      <label for={`${id}-cell`}>Cell<input id={`${id}-cell`} name="cell" type="tel" autocomplete="tel" /></label>
      <label for={`${id}-email`}>Email<input id={`${id}-email`} name="email" type="email" autocomplete="email" required /></label>
      <label for={`${id}-message`}>Message<textarea id={`${id}-message`} name="message" rows="4" required></textarea></label>
      <div class="contact-send"><button class="color-button" type="submit">send</button></div>
      <p class="contact-status" role="status">Opens a draft in your email app.</p>
    </form>
  </div>
</div>
