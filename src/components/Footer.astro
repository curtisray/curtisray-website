---
import '../styles/footer.css';
import { Image } from 'astro:assets';
import penguin from '../assets/penguin-icon.png';
import ContactBar from './ContactBar.astro';
import FooterReveal from './FooterReveal';
interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;
---

<div class:list={{ 'footer-frame': full }}>
  <footer
    id="contact"
    class:list={['site-footer', { 'site-footer-full': full }]}
  >
    {full && (
      <>
        <FooterReveal client:visible={{ rootMargin: '200px' }} />
        <Image
          class="footer-penguin"
          data-parallax="accent"
          src={penguin}
          alt="Penguin with surfboard"
          width={88}
          height={72}
        />
      </>
    )}
    <ContactBar id="footer-contact" />
  </footer>
</div>

<script>
  import '../scripts/footer-canvas';
</script>
