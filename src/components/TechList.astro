---
import { technologies, type Technology } from '../data/site';
import { Image } from 'astro:assets';
interface Props {
  items: Technology[];
  compact?: boolean;
}
const { items, compact = false } = Astro.props;
---

<ul
  class:list={['tech-list', { 'tech-list-compact': compact }]}
  aria-label="Tech stack"
>
  {items.map((key) => {
    const tech = technologies[key];
    return (
      <li>
        <span class="tech-icon">
          {typeof tech.logo === 'string' ? (
            <img
              src={`/logos/${tech.logo}`}
              alt=""
              loading="lazy"
              width={40}
              height={40}
            />
          ) : (
            <Image
              class="tech-icon-raster"
              src={tech.logo}
              alt=""
              width={80}
              height={80}
            />
          )}
        </span>
        <span translate="no">{tech.label}</span>
      </li>
    );
  })}
</ul>
